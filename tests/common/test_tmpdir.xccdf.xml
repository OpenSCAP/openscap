<?xml version="1.0" encoding="UTF-8"?>
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_org.openscap_benchmark_tmpdir">
  <status>accepted</status>
  <title>TMPDIR regression test</title>
  <version>1.0</version>
  <Rule id="xccdf_org.openscap_rule_tmpdir" selected="true">
    <title>Record the temporary remediation script path</title>
    <fix system="urn:xccdf:fix:script:sh"><![CDATA[
      test -f "$0" || exit 1
      printf '%s\n' "$0" > "$TMPDIR/fix-path"
    ]]></fix>
    <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
      <check-content-ref href="test_tmpdir.oval.xml" name="oval:org.openscap.tmpdir:def:1"/>
    </check>
  </Rule>
</Benchmark>
